# MILOS Rust server — environment variable reference
# Copy to .env and fill in real values (never commit .env)

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=milos

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-jwt-secret-in-production

# Admin panel secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=change-this-admin-secret-in-production

# Groq API keys — comma-separated for round-robin rotation
# Get keys at: https://console.groq.com/keys
GROQ_API_KEYS=gsk_your_groq_key_here

# NVIDIA NIM API keys — comma-separated for round-robin rotation
# Get keys at: https://build.nvidia.com (sign up → API Keys)
NVIDIA_API_KEYS=nvapi-your-nvidia-key-here

# Google Gemini API keys — comma-separated for round-robin rotation
# Get keys at: https://aistudio.google.com/apikey
GEMINI_API_KEYS=AIza-your-gemini-key-here

# OpenRouter API keys — comma-separated for round-robin rotation
# Get keys at: https://openrouter.ai/keys
OPENROUTER_API_KEYS=sk-or-v1-your-openrouter-key-here

# Mistral Platform API keys — comma-separated for round-robin rotation (Mistral, GLM, DeepSeek)
# Get keys at: https://console.mistral.ai/api-keys
MISTRAL_API_KEYS=your-mistral-key-here

# Optional: seed an initial admin user on first startup
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# Server port (Vercel/Docker sets this automatically)
PORT=8080
